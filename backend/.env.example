# Copy to backend/.env (or /opt/sandboxed-agent-studio/.env on the VM) — never commit real values.

# LLM — Ollama (ACTIVE when key is set; Anthropic-compatible endpoint)
# Cloud: https://ollama.com (model gemma4:31b-cloud is on the Free plan)
# Local: http://localhost:11434 with api_key "ollama"
OLLAMA_API_KEY=
OLLAMA_API_BASE=https://ollama.com
OLLAMA_MODEL=gemma4:31b-cloud

# LLM — OpenRouter (fallback if no Ollama key)
OPENROUTER_API_KEY=
# Optional override. Leave empty for Anthropic-style (https://openrouter.ai/api/v1/messages).
# Set to https://openrouter.ai/api/v1/chat/completions to force the OpenAI-style endpoint.
OPENROUTER_API_URL=
OR_MODEL=anthropic/claude-3.5-sonnet

# LLM — Vultr Serverless Inference (REQUIRED for Challenge 1 — set these to enable)
# Create a key at: Vultr Dashboard → Serverless Inference → API Keys
VULTR_LLM_ENABLED=true
VULTR_LLM_API_KEY=
VULTR_LLM_API_BASE=https://api.vultrinference.com/v1
VULTR_LLM_MODEL=mimo-v2.6-flash

# Sandbox limits
SANDBOX_MEMORY=512m
SANDBOX_CPUS=0.5
SANDBOX_TIMEOUT_S=60
SANDBOX_IMAGE=sandbox-runner:latest

# App
MAX_TASK_SIZE_MB=25
MAX_RETRIES=3
