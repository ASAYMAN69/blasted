# Copy to backend/.env (or /opt/sandboxed-agent-studio/.env on the VM) — never commit real values.

# LLM — OpenRouter (ACTIVE default)
OPENROUTER_API_KEY=
OR_MODEL=anthropic/claude-3.5-sonnet

# LLM — Vultr Serverless Inference (DISABLED stub; set true + key when enabled)
VULTR_LLM_ENABLED=false
VULTR_LLM_API_KEY=
VULTR_LLM_MODEL=

# Sandbox limits
SANDBOX_MEMORY=512m
SANDBOX_CPUS=0.5
SANDBOX_TIMEOUT_S=60
SANDBOX_IMAGE=sandbox-runner:latest

# App
MAX_TASK_SIZE_MB=25
MAX_RETRIES=3
